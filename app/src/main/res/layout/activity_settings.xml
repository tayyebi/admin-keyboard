<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#1E1E1E">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="28sp"
        android:textColor="#D4D4D4"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="English and Persian keyboard"
        android:textSize="16sp"
        android:textColor="#888888"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Keyboard layout"
        android:textColor="#D4D4D4"
        android:textSize="16sp" />

    <RadioGroup
        android:id="@+id/layout_group"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/layout_tkl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="#2196F3"
            android:text="TKL"
            android:textColor="#D4D4D4" />

        <RadioButton
            android:id="@+id/layout_t9"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="#2196F3"
            android:text="T9"
            android:textColor="#D4D4D4" />
    </RadioGroup>

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: CHECKING..."
        android:textSize="18sp"
        android:textColor="#FFEB3B"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btn_enable"
        android:layout_width="240dp"
        android:layout_height="52dp"
        android:text="Enable Keyboard"
        android:textSize="16sp"
        android:backgroundTint="#2196F3"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_switch"
        android:layout_width="240dp"
        android:layout_height="52dp"
        android:text="Switch Keyboard"
        android:textSize="16sp"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF" />

</LinearLayout>
