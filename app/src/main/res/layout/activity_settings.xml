<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.admin.keyboard.GlassBackdropView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fitsSystemWindows="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="36dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="32sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:textColor="@color/textPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="28dp"
                android:text="@string/tagline"
                android:textSize="15sp"
                android:textColor="@color/textMuted" />

            <!-- Layout card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/GlassCardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_layout" />

                <RadioGroup
                    android:id="@+id/layout_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/glass_track"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <RadioButton
                        android:id="@+id/layout_tkl"
                        style="@style/GlassSegment"
                        android:text="@string/layout_tkl"
                        android:textColor="@color/segment_text" />

                    <RadioButton
                        android:id="@+id/layout_t9"
                        style="@style/GlassSegment"
                        android:text="@string/layout_t9"
                        android:textColor="@color/segment_text" />
                </RadioGroup>

                <TextView
                    android:id="@+id/tv_layout_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/layout_hint_tkl"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/textMuted" />
            </LinearLayout>

            <!-- Status card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/glass_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/GlassCardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_status" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/glass_pill"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:text="@string/status_checking"
                    android:textSize="15sp"
                    android:textColor="@color/statusPending" />

                <Button
                    android:id="@+id/btn_enable"
                    style="@style/GlassButton"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/glass_button_primary"
                    android:text="@string/action_enable" />

                <Button
                    android:id="@+id/btn_switch"
                    style="@style/GlassButton"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/glass_button_ghost"
                    android:text="@string/action_switch" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
